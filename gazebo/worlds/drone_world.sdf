<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.6">
  <world name="drone_world">
    <!-- Directional Sun Light -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Kinematic visual drone model -->
    <include>
      <uri>model://drone</uri>
      <name>drone</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- GUI Camera Position overlooking origin -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-5.0 -5.0 4.0 0 0.45 0.785</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
